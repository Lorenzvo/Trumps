# Copy this to .env.local (gitignored) and fill in your Firebase project's web config
# — Project settings → Your apps → the </> (web) app → SDK setup and configuration.
# These values are public client identifiers, not secrets; Firestore Security Rules
# (not hiding this config) are what actually control access.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
